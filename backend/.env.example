PORT=
NODE_ENV=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=*
DB_CONNECTION_LIMIT=

# Usuario a usar en sales/purchases mientras no exista autenticación (JWT).
# Debe ser un id que ya exista en la tabla users de tu base de datos.
DEFAULT_USER_ID=

# Orígenes permitidos para CORS (dev server del frontend, Vite).
# Puede ser una lista separada por comas, útil si accedes también desde otro
# dispositivo en tu red local usando la IP de este equipo.
CORS_ORIGIN=
